{
  "name": "eng-analyzer",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-06",
  "assets": { "directory": "./public", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "eng-analyzer-db", "database_id": "38711e08-4bbf-43af-a657-40b4c89a4bf1", "migrations_dir": "migrations" }
  ],
  // 作成できる保管庫の数。持ち主が作成した後は他人が作れないよう 1 にしている
  "vars": { "MAX_VAULTS": "1" }
}
